{
  "annotations": { "list": [] },
  "description": "Logs correlated to one browser or Electron replay through a shared session ID.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "targetBlank": true,
      "title": "Open replay viewer",
      "type": "link",
      "url": "http://127.0.0.1:3210/?session=$session_id"
    }
  ],
  "liveNow": true,
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "All log entries containing the selected session ID.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "blue", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({project=~\"$project\",service=~\"$service\",environment=~\"$environment\"} |= \"$session_id\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Session logs",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Errors or exceptions within this replay session.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({project=~\"$project\",service=~\"$service\",environment=~\"$environment\"} |= \"$session_id\" |~ \"(?i)error|fatal|exception\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Session errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Complete ordered log stream for the replay. The replay SDK exposes the ID as X-Session-ID for backend propagation.",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 4 },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "direction": "forward",
          "editorMode": "code",
          "expr": "{project=~\"$project\",service=~\"$service\",environment=~\"$environment\"} |= \"$session_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Correlated log stream",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 42,
  "tags": ["observability", "logs", "session-replay"],
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(project)",
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project",
        "query": "label_values(project)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({project=~\"$project\"}, service)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "query": "label_values({project=~\"$project\"}, service)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({project=~\"$project\",service=~\"$service\"}, environment)",
        "includeAll": true,
        "label": "Environment",
        "multi": true,
        "name": "environment",
        "query": "label_values({project=~\"$project\",service=~\"$service\"}, environment)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "text": "", "value": "" },
        "label": "Session ID",
        "name": "session_id",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Session replay correlation",
  "uid": "session-replay-correlation",
  "version": 1,
  "weekStart": ""
}
